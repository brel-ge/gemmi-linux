menu "SoM drivers"

config SOM_CONNECTCORE
       bool "ConnectCore SoM"
       default n
       help
         Say yes for ConnectCore embedded SoMs.

config DIGI_QCA_WEXT_PRIV
       bool "Digi QCA private Wireless Extensions support"
       depends on CFG80211_WEXT
       select WIRELESS_EXT
       select WEXT_PRIV
       help
         Enable private Wireless Extensions support required by Digi's
         external QCA Wi-Fi driver.

endmenu
