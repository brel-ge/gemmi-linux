# Development fragment for gemmi_defconfig: TFTP kernel with NFS root.
# gemmi_defconfig has networking and NFS off, as in production.
#
#   make gemmi_defconfig gemmi-nfs.config
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_FREESCALE=y
CONFIG_FEC=y
CONFIG_PHYLIB=y
CONFIG_MICREL_PHY=y
CONFIG_IP_PNP=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
