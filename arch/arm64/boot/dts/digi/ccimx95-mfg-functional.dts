/dts-v1/;

#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/usb/pd.h>
/* i.MX95 CPU */
#include "../freescale/imx95.dtsi"
/* Digi ConnectCore 95 (SOM) */
#include "ccimx95.dtsi"

/ {
	model = "Digi International ConnectCore 95 Functional Test Board";
	compatible = "digi,ccimx95-dvk", "digi,ccimx95", "fsl,imx95-19x19-evk", "fsl,imx95";
	digi,machine,name = "ccimx95-dvk";

	chosen {
		stdout-path = &lpuart1;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		reg_1v8_ext: regulator-1v8-ext {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <1800000>;
			regulator-min-microvolt = <1800000>;
			regulator-name = "1v8_ext";
			vin-supply = <&reg_vdd_1v8_dummy>;
		};

		reg_3v3_ext: regulator-3v3-ext {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <3300000>;
			regulator-min-microvolt = <3300000>;
			regulator-name = "3v3_ext";
			vin-supply = <&reg_vdd_3v3_dummy>;
		};

		reg_5v_in: regulator-5v-board {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <5000000>;
			regulator-min-microvolt = <5000000>;
			regulator-name = "5v_in";
			enable-active-high;
		};
	};
};

&adc1 {
	status = "okay";
};

&csi_pixel_formatter_0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			formatter_0_in: endpoint {
				remote-endpoint = <&mipi_csi0_out>;
			};
		};

		port@1 {
			reg = <1>;

			formatter_0_out: endpoint {
				remote-endpoint = <&isi_in_2>;
			};
		};
	};
};

&displaymix_irqsteer {
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&dphy_rx {
	status = "okay";
};

&dpu {
	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-rates = <0>, <4008000000>, <445333334>;
	status = "okay";
};

&isi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		* ISI ports 0 and 1 are fed by DPU pixel-link outputs.
		* ISI ports 2 and 3 are fed by CameraMix
		* (formatter/interleaver) outputs.
		*/
		port@2 {
			reg = <2>;

			isi_in_2: endpoint {
				remote-endpoint = <&formatter_0_out>;
			};
		};
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	status = "okay";

	/* MIPI-CSI camera */
	os08a20: os08a20_mipi@36 {
		compatible = "ovti,os08a20";
		reg = <0x36>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_mipi_camera>;
		reset-gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
		orientation = <2>;
		rotation = <0>;
		status = "okay";

		port {
			os08a20_mipi_0_ep: endpoint {
				remote-endpoint = <&mipi_csi0_ep>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
			};
		};
	};
};

/* Console */
&lpuart1 {
	/* Errata: DMA does not work on LPUART1 */
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

&mipi_csi0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			mipi_csi0_ep: endpoint {
				remote-endpoint = <&os08a20_mipi_0_ep>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
			};
		};

		port@1 {
			reg = <1>;
			mipi_csi0_out: endpoint {
				remote-endpoint = <&formatter_0_in>;
			};
		};
	};
};

&mipi_dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			mipi_dsi_panel_out: endpoint {
				remote-endpoint = <&mipi_dsi_panel_in>;
			};
		};
	};

	panel@0 {
		compatible = "newhaven,nhd-3.5-640480ef-msxp";
		reg = <0>;
		VCC-supply = <&reg_3v3_ext>;
		IOVCC-supply = <&reg_3v3_ext>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_mipi_display>;
		reset-gpios = <&gpio5 9 GPIO_ACTIVE_HIGH>;
		dsi-lanes = <4>;
		status = "okay";

		port {
			mipi_dsi_panel_in: endpoint {
				remote-endpoint = <&mipi_dsi_panel_out>;
			};
		};
	};
};

&neoisp0 {
	status = "okay";
};

/* M.2 E-Key slot */
&pcie0 {
	vpcie-supply = <&reg_3v3_ext>;
	status = "okay";
};

/* M.2 B-Key slot */
&pcie1 {
	vpcie-supply = <&reg_3v3_ext>;
	status = "okay";
};

&pcie1_ep {
	vpcie-supply = <&reg_3v3_ext>;
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&usb2 {
	vbus-supply = <&reg_5v_in>;
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	role-switch-default-mode = "host";
	snps,dis-u1-entry-quirk;
	snps,dis-u2-entry-quirk;
	status = "okay";
};

&usb3_phy {
	vbus-supply = <&reg_5v_in>;
	fsl,phy-pcs-tx-deemph-3p5db-attenuation-db = <17>;
	fsl,phy-pcs-tx-swing-full-percent = <100>;
	fsl,phy-tx-preemp-amp-tune-microamp = <600>;
	fsl,phy-tx-vboost-level-microvolt = <1156>;
	status = "okay";
};

&vpuctrl {
	boot = <&vpu_boot>;
	sram = <&sram1>;
};

&wdog3 {
	status = "okay";
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio>, <&pinctrl_gpio_non_wb>;

	pinctrl_gpio: gpiogrp {
		fsl,pins = <
			/* Common pairs */
			IMX95_PAD_XSPI1_SS1_B__GPIO5_IO_BIT11	0x31e
			IMX95_PAD_SAI1_RXD0__AONMIX_TOP_GPIO1_IO_BIT14	0x31e

			IMX95_PAD_UART2_RXD__AONMIX_TOP_GPIO1_IO_BIT6	0x31e
			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_GPIO1_IO_BIT13	0x31e

			IMX95_PAD_GPIO_IO07__GPIO2_IO_BIT7	0x31e
			IMX95_PAD_UART2_TXD__AONMIX_TOP_GPIO1_IO_BIT7	0x31e

			IMX95_PAD_GPIO_IO04__GPIO2_IO_BIT4	0x31e
			IMX95_PAD_XSPI1_DATA1__GPIO5_IO_BIT1	0x31e

			IMX95_PAD_GPIO_IO29__GPIO2_IO_BIT29	0x31e
			IMX95_PAD_XSPI1_DATA3__GPIO5_IO_BIT3	0x31e

			IMX95_PAD_XSPI1_DATA0__GPIO5_IO_BIT0	0x31e
			IMX95_PAD_GPIO_IO31__GPIO2_IO_BIT31	0x31e

			IMX95_PAD_GPIO_IO34__GPIO5_IO_BIT14	0x31e
			IMX95_PAD_XSPI1_DATA4__GPIO5_IO_BIT4	0x31e

			IMX95_PAD_SD2_DATA0__GPIO3_IO_BIT3	0x31e
			IMX95_PAD_GPIO_IO00__GPIO2_IO_BIT0	0x31e

			IMX95_PAD_SD2_DATA1__GPIO3_IO_BIT4	0x31e
			IMX95_PAD_I2C2_SCL__AONMIX_TOP_GPIO1_IO_BIT2	0x31e

			IMX95_PAD_SD2_DATA3__GPIO3_IO_BIT6	0x31e
			IMX95_PAD_GPIO_IO01__GPIO2_IO_BIT1	0x31e

			IMX95_PAD_GPIO_IO08__GPIO2_IO_BIT8	0x31e
			IMX95_PAD_PDM_BIT_STREAM0__AONMIX_TOP_GPIO1_IO_BIT9	0x31e

			IMX95_PAD_GPIO_IO09__GPIO2_IO_BIT9	0x31e
			IMX95_PAD_GPIO_IO27__GPIO2_IO_BIT27	0x31e

			IMX95_PAD_GPIO_IO10__GPIO2_IO_BIT10	0x31e
			IMX95_PAD_GPIO_IO25__GPIO2_IO_BIT25	0x31e

			IMX95_PAD_SD2_CMD__GPIO3_IO_BIT2	0x31e
			IMX95_PAD_I2C2_SDA__AONMIX_TOP_GPIO1_IO_BIT3	0x31e

			IMX95_PAD_SD2_DATA2__GPIO3_IO_BIT5	0x31e
			IMX95_PAD_GPIO_IO14__GPIO2_IO_BIT14	0x31e

			IMX95_PAD_SD2_CLK__GPIO3_IO_BIT1	0x31e
			IMX95_PAD_GPIO_IO12__GPIO2_IO_BIT12	0x31e

			IMX95_PAD_GPIO_IO11__GPIO2_IO_BIT11	0x31e
			IMX95_PAD_PDM_CLK__AONMIX_TOP_GPIO1_IO_BIT8	0x31e

			IMX95_PAD_GPIO_IO35__GPIO5_IO_BIT15	0x31e
			IMX95_PAD_XSPI1_DATA5__GPIO5_IO_BIT5	0x31e

			IMX95_PAD_GPIO_IO36__GPIO5_IO_BIT16	0x31e
			IMX95_PAD_XSPI1_DATA6__GPIO5_IO_BIT6	0x31e

			IMX95_PAD_GPIO_IO33__GPIO5_IO_BIT13	0x31e
			IMX95_PAD_XSPI1_DATA7__GPIO5_IO_BIT7	0x31e

			IMX95_PAD_GPIO_IO24__GPIO2_IO_BIT24	0x31e
			IMX95_PAD_GPIO_IO15__GPIO2_IO_BIT15	0x31e

			IMX95_PAD_GPIO_IO32__GPIO5_IO_BIT12	0x31e
			IMX95_PAD_GPIO_IO21__GPIO2_IO_BIT21	0x31e

			IMX95_PAD_GPIO_IO13__GPIO2_IO_BIT13	0x31e
			IMX95_PAD_SAI1_TXC__AONMIX_TOP_GPIO1_IO_BIT12	0x31e

			IMX95_PAD_GPIO_IO16__GPIO2_IO_BIT16	0x31e
			IMX95_PAD_SD2_RESET_B__GPIO3_IO_BIT7	0x31e

			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_GPIO1_IO_BIT11	0x31e
			IMX95_PAD_CCM_CLKO2__GPIO3_IO_BIT27	0x31e

			IMX95_PAD_ENET2_MDIO__GPIO4_IO_BIT15	0x31e
			IMX95_PAD_CCM_CLKO1__GPIO3_IO_BIT26	0x31e

			IMX95_PAD_CCM_CLKO4__GPIO4_IO_BIT29	0x31e
			IMX95_PAD_ENET2_MDC__GPIO4_IO_BIT14	0x31e

			IMX95_PAD_GPIO_IO37__GPIO5_IO_BIT17	0x31e
			IMX95_PAD_GPIO_IO17__GPIO2_IO_BIT17	0x31e

			IMX95_PAD_ENET1_TXC__GPIO4_IO_BIT7	0x31e
			IMX95_PAD_ENET2_TXC__GPIO4_IO_BIT21	0x31e

			IMX95_PAD_ENET1_RXC__GPIO4_IO_BIT9	0x31e
			IMX95_PAD_ENET2_RXC__GPIO4_IO_BIT23	0x31e

			IMX95_PAD_ENET1_TX_CTL__GPIO4_IO_BIT6	0x31e
			IMX95_PAD_ENET2_TX_CTL__GPIO4_IO_BIT20	0x31e

			IMX95_PAD_ENET1_TD1__GPIO4_IO_BIT4	0x31e
			IMX95_PAD_ENET2_TD1__GPIO4_IO_BIT18	0x31e

			IMX95_PAD_ENET1_TD3__GPIO4_IO_BIT2	0x31e
			IMX95_PAD_ENET2_TD3__GPIO4_IO_BIT16	0x31e

			IMX95_PAD_ENET1_RD0__GPIO4_IO_BIT10	0x31e
			IMX95_PAD_ENET2_RD0__GPIO4_IO_BIT24	0x31e

			IMX95_PAD_ENET1_RD2__GPIO4_IO_BIT12	0x31e
			IMX95_PAD_ENET2_RD2__GPIO4_IO_BIT26	0x31e

			IMX95_PAD_ENET1_RX_CTL__GPIO4_IO_BIT8	0x31e
			IMX95_PAD_ENET2_RX_CTL__GPIO4_IO_BIT22	0x31e

			IMX95_PAD_ENET1_TD0__GPIO4_IO_BIT5	0x31e
			IMX95_PAD_ENET2_TD0__GPIO4_IO_BIT19	0x31e

			IMX95_PAD_ENET1_TD2__GPIO4_IO_BIT3	0x31e
			IMX95_PAD_ENET2_TD2__GPIO4_IO_BIT17	0x31e

			IMX95_PAD_ENET1_RD1__GPIO4_IO_BIT11	0x31e
			IMX95_PAD_ENET2_RD1__GPIO4_IO_BIT25	0x31e

			IMX95_PAD_ENET1_RD3__GPIO4_IO_BIT13	0x31e
			IMX95_PAD_ENET2_RD3__GPIO4_IO_BIT27	0x31e

			IMX95_PAD_GPIO_IO23__GPIO2_IO_BIT23	0x31e
			IMX95_PAD_GPIO_IO28__GPIO2_IO_BIT28	0x31e

			IMX95_PAD_GPIO_IO20__GPIO2_IO_BIT20	0x31e
			IMX95_PAD_GPIO_IO26__GPIO2_IO_BIT26	0x31e
			IMX95_PAD_XSPI1_SS0_B__GPIO5_IO_BIT10	0x31e

			IMX95_PAD_GPIO_IO05__GPIO2_IO_BIT5	0x31e
			IMX95_PAD_XSPI1_DATA2__GPIO5_IO_BIT2	0x31e

			IMX95_PAD_GPIO_IO30__GPIO2_IO_BIT30	0x31e
			IMX95_PAD_XSPI1_DQS__GPIO5_IO_BIT8	0x31e

			IMX95_PAD_ENET1_MDC__GPIO4_IO_BIT0	0x31e
			IMX95_PAD_ENET1_MDIO__GPIO4_IO_BIT1	0x31e
		>;
	};

	pinctrl_gpio_non_wb: gpiononwbgrp {
		fsl,pins = <
			/* Non-wireless pairs */
			IMX95_PAD_SD3_DATA1__GPIO3_IO_BIT23	0x31e
			IMX95_PAD_SD3_CLK__GPIO3_IO_BIT20	0x31e

			IMX95_PAD_SD3_DATA2__GPIO3_IO_BIT24	0x31e
			IMX95_PAD_SD3_CMD__GPIO3_IO_BIT21	0x31e

			IMX95_PAD_SD3_DATA3__GPIO3_IO_BIT25	0x31e
			IMX95_PAD_SD3_DATA0__GPIO3_IO_BIT22	0x31e

			IMX95_PAD_CCM_CLKO3__GPIO4_IO_BIT28	0x31e
			IMX95_PAD_GPIO_IO18__GPIO2_IO_BIT18	0x31e

			IMX95_PAD_GPIO_IO19__GPIO2_IO_BIT19	0x31e
			IMX95_PAD_GPIO_IO06__GPIO2_IO_BIT6	0x31e
		>;
	};

	/* MIPI camera */
	pinctrl_mipi_camera: mipicamera {
		fsl,pins = <
			/* CSI1_PWDN# */
			IMX95_PAD_SD2_CD_B__GPIO3_IO_BIT0	0x31e
		>;
	};

	/* MIPI display */
	pinctrl_mipi_display: mipidisplay {
		fsl,pins = <
			/* DISP_RESET */
			IMX95_PAD_XSPI1_SCLK__GPIO5_IO_BIT9	0x31e
		>;
	};
};
