/dts-v1/;

#include "../freescale/imx95-pinfunc.h"
#include "../freescale/imx95-clock.h"
#include <dt-bindings/gpio/gpio.h>

/* Digi ConnectCore 95 Functional Test board */
#include "ccimx95-mfg-functional.dts"

/ {
	bluetooth {
		/* U-Boot will fill in the MAC address here */
	};

	wireless {
		/* U-Boot will fill in the MAC address here */
	};

	wlan_pwrseq: wlan-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_ctrl>;
		reset-gpios = <&gpio2 19 GPIO_ACTIVE_LOW>; /* WL_REG_ON */
		/* Use CCM CKO3 to clock the Wi-Fi chipset */
		clocks = <&scmi_clk IMX95_CLK_CCMCKO3>;
		clock-names = "ext_clock";
		/* Configure CCMCKO3 to be sourced from 32K */
		assigned-clocks = <&scmi_clk IMX95_CLK_CCMCKO3>;
		assigned-clock-parents = <&scmi_clk IMX95_CLK_32K>;
		status = "okay";
	};
};

&lpuart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5_bt>, <&pinctrl_bt_ctrl>;
	status = "okay";

	bluetooth {
		compatible = "infineon,cyw55572-bt";
		shutdown-gpios = <&gpio2 18 GPIO_ACTIVE_HIGH>; /* BT_REG_EN */
		max-speed = <3000000>;
		brcm,requires-autobaud-mode;
		vbatt-supply = <&reg_vdd_3v3_dummy>;
		vddio-supply = <&reg_1v8_rf>;
		/* Use CCM CKO3 to clock the Wi-Fi chipset */
		clocks = <&scmi_clk IMX95_CLK_CCMCKO3>;
		clock-names = "txco";
		/* Configure CCMCKO3 to be sourced from 32K */
		assigned-clocks = <&scmi_clk IMX95_CLK_CCMCKO3>;
		assigned-clock-parents = <&scmi_clk IMX95_CLK_32K>;
		status = "okay";
	};
};

&reg_1v8_rf {
	status = "okay";
};

&usdhc3 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc3>;
	mmc-pwrseq = <&wlan_pwrseq>;
	vqmmc-supply = <&reg_1v8_rf>;
	bus-width = <4>;
	cap-power-off-card;
	non-removable;
	wakeup-source;
	max-frequency = <100000000>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	brcmf: bcrmf@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&scmi_iomuxc {
	pinctrl-0 = <&pinctrl_gpio>;

	pinctrl_bt_ctrl: btctrl {
		fsl,pins = <
			/* 32 kHz clock */
			IMX95_PAD_CCM_CLKO3__CCMSRCGPCMIX_TOP_CLKO_3	0x111e
			/* BT_REG_EN */
			IMX95_PAD_GPIO_IO18__GPIO2_IO_BIT18	0x31e
		>;
	};

	pinctrl_uart5_bt: uart5grpbt {
		fsl,pins = <
			IMX95_PAD_DAP_TDO_TRACESWO__LPUART5_TX	0x31e
			IMX95_PAD_DAP_TDI__LPUART5_RX		0x31e
			IMX95_PAD_DAP_TCLK_SWCLK__LPUART5_CTS_B	0x31e
			IMX95_PAD_DAP_TMS_SWDIO__LPUART5_RTS_B	0x31e
		>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			IMX95_PAD_SD3_CLK__USDHC3_CLK				0x1582
			IMX95_PAD_SD3_CMD__USDHC3_CMD				0x1382
			IMX95_PAD_SD3_DATA0__USDHC3_DATA0			0x1382
			IMX95_PAD_SD3_DATA1__USDHC3_DATA1			0x1382
			IMX95_PAD_SD3_DATA2__USDHC3_DATA2			0x1382
			IMX95_PAD_SD3_DATA3__USDHC3_DATA3			0x1382
		>;
	};

	pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
		fsl,pins = <
			IMX95_PAD_SD3_CLK__USDHC3_CLK				0x158e
			IMX95_PAD_SD3_CMD__USDHC3_CMD				0x138e
			IMX95_PAD_SD3_DATA0__USDHC3_DATA0			0x138e
			IMX95_PAD_SD3_DATA1__USDHC3_DATA1			0x138e
			IMX95_PAD_SD3_DATA2__USDHC3_DATA2			0x138e
			IMX95_PAD_SD3_DATA3__USDHC3_DATA3			0x138e
		>;
	};

	pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
		fsl,pins = <
			IMX95_PAD_SD3_CLK__USDHC3_CLK				0x15fe
			IMX95_PAD_SD3_CMD__USDHC3_CMD				0x13fe
			IMX95_PAD_SD3_DATA0__USDHC3_DATA0			0x13fe
			IMX95_PAD_SD3_DATA1__USDHC3_DATA1			0x13fe
			IMX95_PAD_SD3_DATA2__USDHC3_DATA2			0x13fe
			IMX95_PAD_SD3_DATA3__USDHC3_DATA3			0x13fe
		>;
	};

	pinctrl_wifi_ctrl: wifictrl {
		fsl,pins = <
			/* 32 kHz clock */
			IMX95_PAD_CCM_CLKO3__CCMSRCGPCMIX_TOP_CLKO_3	0x111e
			/* WL_REG_ON */
			IMX95_PAD_GPIO_IO19__GPIO2_IO_BIT19	0x31e
		>;
	};
};
